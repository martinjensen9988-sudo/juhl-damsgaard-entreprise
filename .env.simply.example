# Copy these values into .env.production before building for Simply.com.
# Do not upload .env.production to public_html.

VITE_BASE44_APP_ID=your_base44_app_id
VITE_BASE44_APP_BASE_URL=https://your-base44-app.example

# Optional. Leave empty unless Base44 gives you a specific functions version.
VITE_BASE44_FUNCTIONS_VERSION=
