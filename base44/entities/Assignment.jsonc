{
  "name": "Assignment",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Projekt"
    },
    "project_name": {
      "type": "string",
      "title": "Projektnavn"
    },
    "employee_name": {
      "type": "string",
      "title": "Medarbejder"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Dato"
    },
    "notes": {
      "type": "string",
      "title": "Noter"
    }
  },
  "required": [
    "project_id",
    "employee_name",
    "date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}