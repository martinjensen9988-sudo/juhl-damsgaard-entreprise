{
  "name": "WebsiteInquiry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Navn"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Telefon"
    },
    "project_type": {
      "type": "string",
      "title": "Opgavetype",
      "enum": [
        "Gravearbejde",
        "Kloak",
        "Asfalt",
        "Beton",
        "Nedrivning",
        "Anl\u00e6g",
        "Malerarbejde",
        "T\u00f8mrer",
        "VVS",
        "Elektriker",
        "Totalentreprise",
        "Andet"
      ],
      "default": "Andet"
    },
    "description": {
      "type": "string",
      "title": "Bem\u00e6rkninger"
    },
    "request_summary": {
      "type": "string",
      "title": "Kundens beskrivelse"
    },
    "line_items": {
      "type": "array",
      "title": "Tilbudslinjer",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "title": "Beskrivelse"
          },
          "quantity": {
            "type": "number",
            "title": "Antal"
          },
          "unit": {
            "type": "string",
            "title": "Enhed"
          },
          "unit_price": {
            "type": "number",
            "title": "Stk. pris"
          },
          "line_total": {
            "type": "number",
            "title": "Linje total"
          }
        }
      }
    },
    "estimated_budget": {
      "type": "number",
      "title": "Estimeret budget (DKK)"
    },
    "quote_total": {
      "type": "number",
      "title": "Tilbud total inkl. moms"
    },
    "address": {
      "type": "string",
      "title": "Adresse"
    },
    "source": {
      "type": "string",
      "title": "Kilde",
      "enum": [
        "Forside kontakt",
        "Prisberegner",
        "AI tilbudschat",
        "Telefon",
        "Andet"
      ],
      "default": "Forside kontakt"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Ny",
        "Kontaktet",
        "Tilbud sendt",
        "Konverteret",
        "Tabt"
      ],
      "default": "Ny"
    },
    "converted_project_id": {
      "type": "string",
      "title": "Konverteret til projekt"
    },
    "submitted_date": {
      "type": "string",
      "format": "date",
      "title": "Indsendt"
    },
    "notes": {
      "type": "string",
      "title": "Noter"
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}