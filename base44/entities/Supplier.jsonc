{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Virksomhed"
    },
    "contact_person": {
      "type": "string",
      "title": "Kontaktperson"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Telefon"
    },
    "address": {
      "type": "string",
      "title": "Adresse"
    },
    "postal_code": {
      "type": "string",
      "title": "Postnummer"
    },
    "city": {
      "type": "string",
      "title": "By"
    },
    "cvr": {
      "type": "string",
      "title": "CVR-nr."
    },
    "category": {
      "type": "string",
      "title": "Kategori",
      "enum": [
        "Byggematerialer",
        "Maskiner",
        "Transport",
        "V\u00e6rkt\u00f8j",
        "Andet"
      ],
      "default": "Byggematerialer"
    },
    "notes": {
      "type": "string",
      "title": "Noter"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}