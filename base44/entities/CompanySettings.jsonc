{
  "name": "CompanySettings",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "title": "Virksomhedsnavn"
    },
    "cvr": {
      "type": "string",
      "title": "CVR-nr."
    },
    "address": {
      "type": "string",
      "title": "Adresse"
    },
    "postal_code": {
      "type": "string",
      "title": "Postnummer"
    },
    "city": {
      "type": "string",
      "title": "By"
    },
    "phone": {
      "type": "string",
      "title": "Telefon"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "vat_rate": {
      "type": "number",
      "title": "Moms (%)",
      "default": 25
    },
    "invoice_prefix": {
      "type": "string",
      "title": "Faktura prefix",
      "default": "FAK"
    },
    "quote_prefix": {
      "type": "string",
      "title": "Tilbud prefix",
      "default": "TIL"
    },
    "payment_terms": {
      "type": "string",
      "title": "Betalingsbetingelser",
      "default": "15 dage netto"
    },
    "bank_account": {
      "type": "string",
      "title": "Bankkonto"
    },
    "accounting_system": {
      "type": "string",
      "title": "Regnskabssystem",
      "enum": [
        "none",
        "dinero",
        "economic",
        "billy"
      ],
      "default": "none"
    },
    "accounting_api_key": {
      "type": "string",
      "title": "API-n\u00f8gle"
    },
    "accounting_org_id": {
      "type": "string",
      "title": "Aftalenummer"
    },
    "accounting_sync_invoices": {
      "type": "boolean",
      "title": "Synkroniser fakturaer",
      "default": true
    },
    "accounting_sync_customers": {
      "type": "boolean",
      "title": "Synkroniser kunder",
      "default": true
    }
  },
  "required": [
    "company_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}