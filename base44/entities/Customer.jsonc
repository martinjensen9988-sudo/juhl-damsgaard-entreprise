{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Kontaktperson"
    },
    "company": {
      "type": "string",
      "title": "Virksomhed"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Telefon"
    },
    "address": {
      "type": "string",
      "title": "Adresse"
    },
    "postal_code": {
      "type": "string",
      "title": "Postnummer"
    },
    "city": {
      "type": "string",
      "title": "By"
    },
    "cvr": {
      "type": "string",
      "title": "CVR-nr."
    },
    "payment_terms": {
      "type": "string",
      "title": "Betalingsbetingelser",
      "enum": [
        "8 dage netto",
        "15 dage netto",
        "30 dage netto",
        "45 dage netto",
        "60 dage netto",
        "Kontant",
        "Forudbetaling"
      ],
      "default": "15 dage netto"
    },
    "notes": {
      "type": "string",
      "title": "Noter"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}