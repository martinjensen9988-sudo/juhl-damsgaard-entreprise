{
  "name": "QualityCheck",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Projekt"
    },
    "project_name": {
      "type": "string",
      "title": "Projektnavn"
    },
    "customer_email": {
      "type": "string",
      "title": "Kundeemail"
    },
    "title": {
      "type": "string",
      "title": "Titel"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "F\u00e6rdigmelding",
        "AR-bevis",
        "Sikkerhedsinspektion",
        "Selvangivelse",
        "Varmeinstallation",
        "Andet"
      ],
      "default": "F\u00e6rdigmelding"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Ikke startet",
        "I gang",
        "Godkendt",
        "Afvigelse"
      ],
      "default": "Ikke startet"
    },
    "items": {
      "type": "array",
      "title": "Tjekpunkter",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "title": "Beskrivelse"
          },
          "checked": {
            "type": "boolean",
            "title": "Tjekket"
          },
          "notes": {
            "type": "string",
            "title": "Noter"
          }
        }
      }
    },
    "checked_by": {
      "type": "string",
      "title": "Tjekket af"
    },
    "check_date": {
      "type": "string",
      "format": "date",
      "title": "Dato"
    },
    "notes": {
      "type": "string",
      "title": "Noter"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}