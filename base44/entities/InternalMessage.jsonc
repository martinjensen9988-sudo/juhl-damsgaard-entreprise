{
  "name": "InternalMessage",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Titel"
    },
    "message": {
      "type": "string",
      "title": "Besked"
    },
    "priority": {
      "type": "string",
      "title": "Prioritet",
      "enum": [
        "Lav",
        "Normal",
        "H\u00f8j",
        "Vigtig"
      ],
      "default": "Normal"
    },
    "category": {
      "type": "string",
      "title": "Kategori",
      "enum": [
        "Generel",
        "M\u00f8de",
        "Sikkerhed",
        " project",
        "Personale",
        "Andet"
      ],
      "default": "Generel"
    },
    "author_name": {
      "type": "string",
      "title": "Forfatter"
    },
    "author_email": {
      "type": "string",
      "title": "Forfatter-email"
    },
    "is_reply": {
      "type": "boolean",
      "title": "Svar fra kontoret",
      "default": false
    },
    "is_broadcast": {
      "type": "boolean",
      "title": "Udsendelse til medarbejdere",
      "default": false
    },
    "parent_id": {
      "type": "string",
      "title": "Svar p\u00e5"
    },
    "recipient_user_id": {
      "type": "string",
      "title": "Modtager bruger-ID"
    },
    "active": {
      "type": "boolean",
      "title": "Aktiv",
      "default": true
    },
    "expires_date": {
      "type": "string",
      "format": "date",
      "title": "Udl\u00f8ber"
    }
  },
  "required": [
    "title",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.recipient_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}