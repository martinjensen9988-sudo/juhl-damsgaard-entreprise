{
  "name": "EquipmentBooking",
  "type": "object",
  "properties": {
    "equipment_id": {
      "type": "string",
      "title": "Materiel"
    },
    "equipment_name": {
      "type": "string",
      "title": "Materielnavn"
    },
    "project_id": {
      "type": "string",
      "title": "Projekt"
    },
    "project_name": {
      "type": "string",
      "title": "Projektnavn"
    },
    "employee_name": {
      "type": "string",
      "title": "Booket af"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Fra dato"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "Til dato"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Reserveret",
        "Udleveret",
        "Returneret",
        "Annulleret"
      ],
      "default": "Reserveret"
    },
    "is_external_rental": {
      "type": "boolean",
      "title": "Ekstern udlejning",
      "default": false
    },
    "renter_name": {
      "type": "string",
      "title": "Lejer"
    },
    "renter_company": {
      "type": "string",
      "title": "Lejer virksomhed"
    },
    "renter_phone": {
      "type": "string",
      "title": "Lejer telefon"
    },
    "daily_rate": {
      "type": "number",
      "title": "Dagspris (DKK)"
    },
    "total_price": {
      "type": "number",
      "title": "Totalpris (DKK)"
    },
    "invoice_number": {
      "type": "string",
      "title": "Fakturanr."
    },
    "notes": {
      "type": "string",
      "title": "Noter"
    }
  },
  "required": [
    "equipment_name",
    "start_date",
    "end_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}