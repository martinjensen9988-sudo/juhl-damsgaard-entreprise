{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Titel"
    },
    "description": {
      "type": "string",
      "title": "Beskrivelse"
    },
    "assigned_to": {
      "type": "string",
      "title": "Tildelt til"
    },
    "assigned_user_id": {
      "type": "string",
      "title": "Tildelt bruger-ID"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Ikke startet",
        "I gang",
        "Afventer",
        "Gennemf\u00f8rt"
      ],
      "default": "Ikke startet"
    },
    "priority": {
      "type": "string",
      "title": "Prioritet",
      "enum": [
        "Lav",
        "Normal",
        "H\u00f8j"
      ],
      "default": "Normal"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Deadline"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "title": "Gennemf\u00f8rt"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.assigned_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.assigned_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}