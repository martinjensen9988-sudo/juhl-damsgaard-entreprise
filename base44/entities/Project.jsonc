{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Projektnavn"
    },
    "customer_id": {
      "type": "string",
      "title": "Kunde"
    },
    "customer_name": {
      "type": "string",
      "title": "Kundenavn"
    },
    "customer_email": {
      "type": "string",
      "title": "Kundeemail"
    },
    "description": {
      "type": "string",
      "title": "Beskrivelse"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "Gravearbejde",
        "Kloak",
        "Asfalt",
        "Beton",
        "Nedrivning",
        "Anl\u00e6g",
        "Andet"
      ],
      "default": "Anl\u00e6g"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Planl\u00e6gning",
        "I gang",
        "F\u00e6rdig",
        "Afsluttet",
        "P\u00e5 hold"
      ],
      "default": "Planl\u00e6gning"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Startdato"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "Slutdato"
    },
    "budget": {
      "type": "number",
      "title": "Budget (DKK)"
    },
    "address": {
      "type": "string",
      "title": "Adresse"
    },
    "subcontractor_id": {
      "type": "string",
      "title": "Underentrepren\u00f8r"
    },
    "subcontractor_name": {
      "type": "string",
      "title": "Underentrepren\u00f8r navn"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}