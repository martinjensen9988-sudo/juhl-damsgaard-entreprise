{
  "name": "ProjectImage",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Projekt"
    },
    "project_name": {
      "type": "string",
      "title": "Projektnavn"
    },
    "customer_email": {
      "type": "string",
      "title": "Kundeemail"
    },
    "image_url": {
      "type": "string",
      "title": "Billede URL"
    },
    "caption": {
      "type": "string",
      "title": "Billedtekst"
    },
    "phase": {
      "type": "string",
      "title": "Fase",
      "enum": [
        "Start",
        "Igangv\u00e6rende",
        "Afsluttet"
      ],
      "default": "Igangv\u00e6rende"
    },
    "upload_date": {
      "type": "string",
      "format": "date",
      "title": "Dato"
    }
  },
  "required": [
    "project_id",
    "image_url"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}