{
  "name": "Quote",
  "type": "object",
  "properties": {
    "quote_number": {
      "type": "string",
      "title": "Tilbudsnr."
    },
    "customer_id": {
      "type": "string",
      "title": "Kunde"
    },
    "customer_name": {
      "type": "string",
      "title": "Kundenavn"
    },
    "customer_email": {
      "type": "string",
      "title": "Kundeemail"
    },
    "project_id": {
      "type": "string",
      "title": "Projekt"
    },
    "project_name": {
      "type": "string",
      "title": "Projektnavn"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Kladde",
        "Sendt",
        "Accepteret",
        "Afvist",
        "Udl\u00f8bet"
      ],
      "default": "Kladde"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Dato"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "title": "Gyldig til"
    },
    "line_items": {
      "type": "array",
      "title": "Linjer",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "title": "Beskrivelse"
          },
          "quantity": {
            "type": "number",
            "title": "Antal"
          },
          "unit": {
            "type": "string",
            "title": "Enhed"
          },
          "unit_price": {
            "type": "number",
            "title": "Stk. pris"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "title": "Bem\u00e6rkninger"
    },
    "viewed_at": {
      "type": "string",
      "title": "Set af kunden"
    },
    "accepted_at": {
      "type": "string",
      "title": "Accepteret den"
    },
    "accepted_by": {
      "type": "string",
      "title": "Accepteret af"
    },
    "accepted_ip": {
      "type": "string",
      "title": "Accepteret fra IP"
    }
  },
  "required": [
    "quote_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}