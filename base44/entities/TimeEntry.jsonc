{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Projekt"
    },
    "project_name": {
      "type": "string",
      "title": "Projektnavn"
    },
    "user_name": {
      "type": "string",
      "title": "Medarbejder"
    },
    "user_id": {
      "type": "string",
      "title": "Bruger ID"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Dato"
    },
    "hours": {
      "type": "number",
      "title": "Timer"
    },
    "description": {
      "type": "string",
      "title": "Beskrivelse"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "I gang",
        "Afsluttet"
      ],
      "default": "Afsluttet"
    },
    "clock_started_at": {
      "type": "string",
      "format": "date-time",
      "title": "Tjek ind tidspunkt"
    },
    "clock_ended_at": {
      "type": "string",
      "format": "date-time",
      "title": "Tjek ud tidspunkt"
    },
    "task_type": {
      "type": "string",
      "title": "Arbejdstype",
      "enum": [
        "Gravearbejde",
        "K\u00f8rsel",
        "Maskinarbejde",
        "H\u00e5ndarbejde",
        "M\u00f8de",
        "Andet"
      ],
      "default": "H\u00e5ndarbejde"
    }
  },
  "required": [
    "project_id",
    "hours"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
